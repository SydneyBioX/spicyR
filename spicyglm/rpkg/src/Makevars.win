# The numeric core lives one level up, shared with the Python front end, and is
# compiled here through the one-line stubs core_*.cpp. Keeping one copy of the
# sources means the two front ends can never drift apart.
CXX_STD = CXX17
PKG_CPPFLAGS = -I../../cpp/include
PKG_CXXFLAGS = $(SHLIB_PTHREAD_FLAGS)
PKG_LIBS = $(SHLIB_PTHREAD_FLAGS)

# The stubs only #include the core, so make cannot see that they depend on it:
# list the dependencies, or a change to the core links stale objects. `all`
# comes first so it stays the default target.
all: $(SHLIB)
CORE_H = ../../cpp/include/spicyglm/core.hpp
core_binomial.o: ../../cpp/src/binomial.cpp $(CORE_H)
core_diagnostics.o: ../../cpp/src/diagnostics.cpp $(CORE_H)
core_model.o: ../../cpp/src/model.cpp $(CORE_H)
core_spatial.o: ../../cpp/src/spatial.cpp $(CORE_H)
bindings.o: $(CORE_H)
